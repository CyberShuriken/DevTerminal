[Desktop Entry]
Type=Application
Name=devterm
GenericName=Terminal
Comment=A terminal laid out like a code editor: shells, editor tabs and a file tree
Exec=@LAUNCH@
Icon=devterm
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;editor;console;command;
StartupWMClass=devterm
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@LAUNCH@
